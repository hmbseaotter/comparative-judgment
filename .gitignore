# Comparison/findings store. There is no implicit store path -- the caller always
# supplies one (D9) -- but this is the conventional location used by the docs and
# examples, ignored so that following them cannot produce a file that quietly
# wants committing. The store holds findings text, which may be sensitive.
.cj-store/
store/

# Credentials. This tool needs none -- it makes no network request of any kind
# -- but "this repo has no secrets" is the sort of statement that stops being
# true quietly, and the entry costs one line. The global pre-commit guard is the
# backstop; this is the primary control.
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Tooling caches
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.pytest_cache/
